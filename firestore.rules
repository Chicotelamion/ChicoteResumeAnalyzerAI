rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserRecord(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow create, read, update: if ownsUserRecord(uid);
    }

    match /resume_profiles/{profileId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /ai_analysis/{analysisId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
